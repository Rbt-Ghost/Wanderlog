<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tripDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="340dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/tripPhotoPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/wl_photo" />

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_top_scrim" />

            <ImageButton
                android:id="@+id/tripDetailBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/trip_detail_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/wl_ink" />

            <TextView
                android:id="@+id/tripPhotoIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_pill_scrim"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tripDetailTitle"
                style="@style/TextAppearance.Wl.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pin"
                    android:tint="@color/wl_warm" />

                <TextView
                    android:id="@+id/tripDetailLocation"
                    style="@style/TextAppearance.Wl.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tripDetailDescription"
                style="@style/TextAppearance.Wl.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tripDetailPhotosLabel"
                style="@style/TextAppearance.Wl.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp" />

            <LinearLayout
                android:id="@+id/tripPhotoGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
